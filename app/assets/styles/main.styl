:root
  for index in 1..12
    --spacing-{index} unit(index * 4, px)
  --radius-sm 4px
  --radius-md 10px
  --radius-lg 16px
  --radius-xl 24px
  --shadow-sm 0 2px 8px #00000008
  --shadow-md 0 8px 24px #0000000d
  --shadow-lg 0 24px 60px #0000001a
  --font-size-xs 12px
  --font-size-sm 14px
  --font-size-lg 20px
  --font-size-xl 24px
  --font-weight-regular 400
  --font-weight-medium 500
  --font-weight-semibold 600
  --font-weight-bold 700
  color-scheme light
.dark
  color-scheme dark
*
  box-sizing border-box
body
  margin 0
  color var(--color-text)
  background var(--color-background)
  font-family projectFontBody, sans-serif
  font-size var(--font-size-base)
  line-height var(--line-height-normal)
  -webkit-font-smoothing antialiased
button
input
select
textarea
  font inherit
h1
h2
h3
p
  margin 0
button
a
select
input
  &:focus-visible
    outline 3px solid var(--color-primary)
    outline-offset 4px
img
  max-width 100%
  height auto
.display
.heading-1
.heading-2
.heading-3
  font-family projectFontHeading, sans-serif
  font-weight var(--font-weight-semibold)
  line-height 1.12
  letter-spacing -0.045em
.display
  max-width 760px
  font-size clamp(40px, 5.4vw, 66px)
.heading-1
  font-size clamp(32px, 4vw, 48px)
.heading-2
  font-size clamp(26px, 3vw, 36px)
.heading-3
  font-size 20px
  letter-spacing -0.025em
.body
  font-size var(--font-size-base)
.body-small
.label
  font-size var(--font-size-sm)
.caption
  font-size var(--font-size-xs)
.label
  font-weight var(--font-weight-medium)
.sr-only
  position absolute
  width 1px
  height 1px
  padding 0
  clip-path inset(50%)
  overflow hidden

@media (prefers-reduced-motion no-preference)
  button
  a
    transition color 0.15s, background-color 0.15s, opacity 0.15s
