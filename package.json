{
  "name": "nuxt-product-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "nuxt dev --dotenv .env.local",
    "build": "nuxt build",
    "build:analyze": "nuxt analyze",
    "build:spa": "node scripts/spa.mjs",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "node scripts/init.mjs && nuxt prepare",
    "project:init": "node scripts/init.mjs && nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . && pnpm lint:styles && prettier --check . && pnpm seo:check",
    "lint:styles": "stylelint \"{app,shared}/**/*.{vue,styl}\" --allow-empty-input --quiet-deprecation-warnings",
    "lint:fix": "eslint . --fix && pnpm lint:styles --fix && prettier --write .",
    "test": "vitest run",
    "test:related": "vitest related --run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "seo:check": "node scripts/seo-check.mjs",
    "api:generate": "node scripts/api-generate.mjs",
    "branding:generate": "node scripts/branding.mjs",
    "security:check": "node scripts/security-check.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "nuxt": "4.6.2",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "@nuxtjs/color-mode": "4.0.1",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxt/fonts": "1.0.1",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@pinia/nuxt": "1.0.3",
    "pinia": "4.1.0",
    "naive-ui": "2.45.3",
    "@css-render/vue3-ssr": "0.15.14",
    "zod": "4.6.7",
    "vee-validate": "4.15.1",
    "openapi-fetch": "0.17.0",
    "@tanstack/query-core": "5.104.4",
    "@vite-pwa/nuxt": "1.1.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-expiration": "7.4.1",
    "openid-client": "6.8.8",
    "nuxt-auth-utils": "0.5.32",
    "@nuxtjs/sitemap": "9.1.0",
    "@nuxtjs/robots": "7.0.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13",
    "@types/node": "24.19.2",
    "stylus": "0.64.0",
    "postcss": "8.5.31",
    "autoprefixer": "10.6.1",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2",
    "eslint-plugin-vue": "10.11.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "stylelint": "16.26.1",
    "stylelint-stylus": "1.0.0",
    "postcss-html": "2.0.0",
    "postcss-styl": "0.12.3",
    "postcss-syntax": "0.36.2",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "@vitejs/plugin-vue": "6.0.10",
    "happy-dom": "21.0.3",
    "@playwright/test": "1.64.1",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "lefthook": "2.2.2",
    "sharp": "0.35.5",
    "@iconify-json/lucide": "1.2.146",
    "@iconify-json/tabler": "1.2.42",
    "@iconify-json/mdi": "1.2.3",
    "@fontsource-variable/inter": "5.3.0",
    "lint-staged": "17.6.0",
    "@vue/compiler-sfc": "3.5.44",
    "lighthouse": "13.5.0"
  }
}
